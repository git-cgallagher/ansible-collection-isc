# Managed by Ansible (git_cgallagher.stork.stork_agent)
STORK_AGENT_HOST=0.0.0.0
STORK_AGENT_PORT={{ stork_agent_port }}
# No STORK_AGENT_SERVER_URL on purpose: when set, the agent tries to
# (re)register at every start and exits fatally with a wildcard host. The
# role registers once, explicitly.
STORK_AGENT_PROMETHEUS_KEA_EXPORTER_ADDRESS=0.0.0.0
STORK_AGENT_PROMETHEUS_KEA_EXPORTER_PORT={{ stork_agent_prometheus_kea_port }}
STORK_AGENT_PROMETHEUS_KEA_EXPORTER_PER_SUBNET_STATS={{ stork_agent_prometheus_kea_per_subnet_stats | bool | lower }}
STORK_AGENT_SKIP_TLS_CERT_VERIFICATION={{ stork_agent_skip_tls_verify | bool | lower }}
{% for k, v in stork_agent_extra_env | dictsort %}
{{ k }}={{ v }}
{% endfor %}
