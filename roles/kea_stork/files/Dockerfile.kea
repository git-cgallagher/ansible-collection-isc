# Multi-arch (amd64 + arm64) Kea image from ISC's own Alpine packages.
# ISC's published images (docker.cloudsmith.io/isc/docker/kea-*) are
# amd64-only, so Graviton EKS nodes and ARM Talos nodes need this.
#
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     --build-arg KEA_BRANCH=3-0 --build-arg KEA_VERSION=3.0.4 \
#     -t <registry>/kea:3.0.4 -f Dockerfile.kea --push .
ARG ALPINE_VERSION=3.22
FROM alpine:${ALPINE_VERSION}
ARG ALPINE_VERSION
ARG KEA_BRANCH=3-0
ARG KEA_VERSION=
RUN set -eux; \
    key="$(wget -qO- "https://dl.cloudsmith.io/public/isc/kea-${KEA_BRANCH}/setup.alpine.sh" | grep -oE 'rsa\.[0-9A-F]+\.key' | head -1)"; \
    wget -qO "/etc/apk/keys/kea-${KEA_BRANCH}@isc-$(echo "$key" | cut -d. -f2).rsa.pub" "https://dl.cloudsmith.io/public/isc/kea-${KEA_BRANCH}/${key}"; \
    echo "https://dl.cloudsmith.io/public/isc/kea-${KEA_BRANCH}/alpine/v${ALPINE_VERSION}/main" >> /etc/apk/repositories; \
    pin="${KEA_VERSION:+~${KEA_VERSION}}"; \
    apk add --no-cache tzdata "isc-kea-dhcp4${pin}" "isc-kea-dhcp6${pin}" "isc-kea-dhcp-ddns${pin}" "isc-kea-hooks${pin}"; \
    mkdir -p /var/lib/kea /var/run/kea /var/log/kea
VOLUME ["/etc/kea", "/var/lib/kea"]
EXPOSE 67/udp 547/udp 8001/tcp 8002/tcp
# (the per-repo RSA key name is read from ISC's setup script, not executed)
# Same default as ISC's image; the role always passes an explicit command.
CMD ["kea-dhcp4", "-c", "/etc/kea/kea-dhcp4.conf"]
