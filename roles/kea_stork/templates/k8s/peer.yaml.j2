{%- set n = _peer.name -%}
{%- set fullname = 'kea-' ~ n -%}
{%- set peer_labels = _kea_k8s_labels | combine({'kea.isc.org/peer': n}) -%}
{%- set families = [] -%}
{%- if (kea_dhcp4_enabled | bool) %}{% set _ = families.append({'v': '4', 'bin': 'kea-dhcp4', 'image': kea_dhcp4_image, 'ctrl': kea_dhcp4_control_port, 'ha': kea_ha_dhcp4_port, 'dhcp': 67}) %}{% endif -%}
{%- if (kea_dhcp6_enabled | bool) %}{% set _ = families.append({'v': '6', 'bin': 'kea-dhcp6', 'image': kea_dhcp6_image, 'ctrl': kea_dhcp6_control_port, 'ha': kea_ha_dhcp6_port, 'dhcp': 547}) %}{% endif -%}
{%- set confs = {} -%}
{%- for f in families -%}
{%-   set _ = confs.update({f.bin ~ '.conf': lookup('ansible.builtin.template', 'kea-dhcp.conf.j2',
        template_vars={'_family': f.v, '_this_name': n})}) -%}
{%- endfor -%}
{%- set lb_ann = {} -%}
{%- if kea_k8s_profile == 'eks' -%}
{#-   AWS Load Balancer Controller NLB. UDP target groups always preserve the
      client IP. NLB needs a TCP health check: use the HA listener (bound
      0.0.0.0) or, single-server, the Stork agent port. -#}
{%-   set _ = lb_ann.update({
        'service.beta.kubernetes.io/aws-load-balancer-type': 'external',
        'service.beta.kubernetes.io/aws-load-balancer-nlb-target-type': 'ip',
        'service.beta.kubernetes.io/aws-load-balancer-scheme': 'internal',
        'service.beta.kubernetes.io/aws-load-balancer-healthcheck-protocol': 'TCP',
        'service.beta.kubernetes.io/aws-load-balancer-healthcheck-port':
          (families[0].ha if (kea_ha_enabled | bool) else stork_agent_port) | string }) -%}
{%- endif -%}
{%- if n in kea_k8s_lb_ips -%}
{%-   if kea_k8s_lb_implementation == 'metallb' %}{% set _ = lb_ann.update({'metallb.io/loadBalancerIPs': kea_k8s_lb_ips[n]}) %}{% endif -%}
{%-   if kea_k8s_lb_implementation == 'cilium' %}{% set _ = lb_ann.update({'lbipam.cilium.io/ips': kea_k8s_lb_ips[n]}) %}{% endif -%}
{%-   if kea_k8s_profile == 'eks' %}{% set _ = lb_ann.update({'service.beta.kubernetes.io/aws-load-balancer-private-ipv4-addresses': kea_k8s_lb_ips[n]}) %}{% endif -%}
{%- endif -%}
{%- set _ = lb_ann.update(kea_k8s_lb_annotations) -%}
{%- set probe_cmd = "wget -q -O- --header 'Content-Type: application/json' --post-data '{\"command\":\"status-get\"}' http://127.0.0.1:%s/ | grep -q '\"result\": *0'" -%}
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ fullname }}-config
  namespace: {{ kea_k8s_namespace }}
  labels: {{ peer_labels | to_json }}
data: {{ confs | to_json }}
---
# Stable per-peer address. Kea HA URLs must be IP literals, so the partner
# reaches this pod through a ClusterIP that never changes.
apiVersion: v1
kind: Service
metadata:
  name: {{ fullname }}
  namespace: {{ kea_k8s_namespace }}
  labels: {{ peer_labels | to_json }}
spec:
  type: ClusterIP
{% if _peer.cluster_ip | default('') | length > 0 %}
  clusterIP: {{ _peer.cluster_ip }}
{% endif %}
  selector: {{ {'kea.isc.org/peer': n, 'app.kubernetes.io/name': 'kea'} | to_json }}
  ports:
{% for f in families %}
{% if (kea_ha_enabled | bool) %}
    - { name: ha{{ f.v }}, port: {{ f.ha }}, targetPort: {{ f.ha }}, protocol: TCP }
{% endif %}
    - { name: dhcp{{ f.v }}, port: {{ f.dhcp }}, targetPort: {{ f.dhcp }}, protocol: UDP }
{% endfor %}
{% if (stork_agent_enabled | bool) %}
    - { name: stork-agent, port: {{ stork_agent_port }}, targetPort: {{ stork_agent_port }}, protocol: TCP }
    - { name: metrics, port: {{ stork_agent_prometheus_kea_port }}, targetPort: {{ stork_agent_prometheus_kea_port }}, protocol: TCP }
{% endif %}
{% if kea_k8s_exposure == 'loadbalancer' %}
---
# DHCP ingress for relay agents. Configure every relay with BOTH peers'
# LB addresses (standard DHCP-HA practice): each peer decides by HA state
# whether to answer.
apiVersion: v1
kind: Service
metadata:
  name: {{ fullname }}-dhcp
  namespace: {{ kea_k8s_namespace }}
  labels: {{ peer_labels | to_json }}
  annotations: {{ lb_ann | to_json }}
spec:
  type: LoadBalancer
{% if kea_k8s_profile == 'eks' %}
  loadBalancerClass: service.k8s.aws/nlb
{% endif %}
  externalTrafficPolicy: Local
{% if kea_k8s_lb_source_ranges %}
  loadBalancerSourceRanges: {{ kea_k8s_lb_source_ranges | to_json }}
{% endif %}
  selector: {{ {'kea.isc.org/peer': n, 'app.kubernetes.io/name': 'kea'} | to_json }}
  ports:
{% for f in families %}
    - { name: dhcp{{ f.v }}, port: {{ f.dhcp }}, targetPort: {{ f.dhcp }}, protocol: UDP }
{% endfor %}
{% endif %}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ fullname }}
  namespace: {{ kea_k8s_namespace }}
  labels: {{ peer_labels | to_json }}
spec:
  replicas: 1   # one pod per HA peer; HA is between StatefulSets, not replicas
  serviceName: {{ fullname }}
  selector:
    matchLabels: {{ {'kea.isc.org/peer': n, 'app.kubernetes.io/name': 'kea'} | to_json }}
  template:
    metadata:
      labels: {{ peer_labels | to_json }}
      annotations:
        kea.isc.org/config-checksum: {{ (confs | to_json | hash('sha256'))[:16] | to_json }}
    spec:
{% if (stork_agent_enabled | bool) %}
      # The Stork agent finds Kea by scanning processes and reading the
      # config path from Kea's command line.
      shareProcessNamespace: true
{% endif %}
{% if kea_k8s_exposure == 'hostnetwork' %}
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
{% endif %}
      terminationGracePeriodSeconds: 15
{% if kea_k8s_image_pull_secrets %}
      imagePullSecrets:
{% for ps in kea_k8s_image_pull_secrets %}
        - { name: {{ ps }} }
{% endfor %}
{% endif %}
{% if kea_k8s_node_selector %}
      nodeSelector: {{ kea_k8s_node_selector | to_json }}
{% endif %}
{% if kea_k8s_tolerations %}
      tolerations: {{ kea_k8s_tolerations | to_json }}
{% endif %}
      affinity:
        podAntiAffinity:
          # Keep HA partners on different nodes when the cluster allows it.
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels: { app.kubernetes.io/name: kea }
      containers:
{% for f in families %}
        - name: {{ f.bin }}
          image: {{ f.image }}
          # Kea 3.x refuses socket/lease dirs looser than 0750; emptyDirs are
          # 0777. Absolute path: not every runtime's PATH has /usr/sbin.
          command:
            - sh
            - -c
            - chmod 0750 {{ kea_control_unix_socket_dir }} /var/lib/kea && exec /usr/sbin/{{ f.bin }} -c /etc/kea/{{ f.bin }}.conf
          ports:
            - { name: dhcp{{ f.v }}, containerPort: {{ f.dhcp }}, protocol: UDP }
{% if (kea_ha_enabled | bool) %}
            - { name: ha{{ f.v }}, containerPort: {{ f.ha }}, protocol: TCP }
{% endif %}
          securityContext:
            allowPrivilegeEscalation: false
            # uid 0 for :67; gid = kea so the 0754 binaries are executable
            # without DAC_OVERRIDE.
            runAsUser: 0
            runAsGroup: {{ kea_image_kea_gid }}
            # NOT drop:[ALL]. ISC's kea-dhcp4 carries file caps
            # cap_net_bind_service,cap_net_raw=ep and exec fails (EPERM)
            # unless both stay in the bounding set — even in UDP-only mode.
            # Both are runtime defaults, so this is PSA "baseline"-compliant
            # (adding NET_RAW explicitly would not be).
            capabilities:
              drop: [AUDIT_WRITE, CHOWN, DAC_OVERRIDE, FOWNER, FSETID, KILL, MKNOD, SETFCAP, SETGID, SETPCAP, SETUID, SYS_CHROOT]
          readinessProbe:
            exec: { command: [sh, -c, {{ (probe_cmd | format(f.ctrl)) | to_json }}] }
            periodSeconds: 10
          livenessProbe:
            exec: { command: [sh, -c, {{ (probe_cmd | format(f.ctrl)) | to_json }}] }
            initialDelaySeconds: 15
            periodSeconds: 20
            failureThreshold: 3
          resources: {{ kea_k8s_resources | to_json }}
          volumeMounts:
            - { name: config, mountPath: /etc/kea, readOnly: true }
            - { name: leases, mountPath: /var/lib/kea, subPath: kea }
            - { name: run, mountPath: /var/run/kea }
            - { name: logs, mountPath: /var/log/kea }
{% endfor %}
{% if (stork_agent_enabled | bool) %}
        - name: stork-agent
          image: {{ stork_agent_image }}
          command:
            - sh
            - -c
            - |
              # Registration persists in /var/lib/stork-agent (on the leases volume).
              if [ ! -f /var/lib/stork-agent/root-cert.pem ]; then
                # register's final step binds a ping listener on --agent-host,
                # which here is the Service address the pod doesn't own. The
                # certs are already stored by then, so that failure is benign;
                # a genuine failure leaves no root-cert.pem and the agent
                # below exits, so the kubelet retries.
                stork-agent register --non-interactive \
                  --server-url "$REGISTER_SERVER_URL" \
                  --agent-host "$AGENT_ADDRESS" --agent-port "$STORK_AGENT_PORT" \
                  ${STORK_AGENT_SERVER_TOKEN:+--server-token "$STORK_AGENT_SERVER_TOKEN"} \
                  || echo "stork-agent register returned $? (see comment in manifest)"
                [ -f /var/lib/stork-agent/root-cert.pem ] || exit 1
              fi
              exec stork-agent
          env:
            - { name: STORK_AGENT_HOST, value: "0.0.0.0" }
            - { name: STORK_AGENT_PORT, value: {{ stork_agent_port | string | to_json }} }
            - { name: REGISTER_SERVER_URL, value: {{ stork_server_url | to_json }} }
            - { name: AGENT_ADDRESS, value: {{ (kea_k8s_stork_agent_addresses[n] | default(fullname ~ '.' ~ kea_k8s_namespace ~ '.svc.cluster.local')) | to_json }} }
            - { name: STORK_AGENT_PROMETHEUS_KEA_EXPORTER_PORT, value: {{ stork_agent_prometheus_kea_port | string | to_json }} }
            - { name: STORK_AGENT_PROMETHEUS_KEA_EXPORTER_PER_SUBNET_STATS, value: {{ stork_agent_prometheus_kea_per_subnet_stats | bool | lower | to_json }} }
            - { name: STORK_AGENT_SKIP_TLS_CERT_VERIFICATION, value: {{ stork_agent_skip_tls_verify | bool | lower | to_json }} }
            - name: STORK_AGENT_SERVER_TOKEN
              valueFrom: { secretKeyRef: { name: kea-stork-agent, key: STORK_AGENT_SERVER_TOKEN, optional: true } }
{% for k, v in stork_agent_extra_env | dictsort %}
            - { name: {{ k }}, value: {{ v | string | to_json }} }
{% endfor %}
          ports:
            - { name: stork-agent, containerPort: {{ stork_agent_port }}, protocol: TCP }
            - { name: metrics, containerPort: {{ stork_agent_prometheus_kea_port }}, protocol: TCP }
          securityContext:
            allowPrivilegeEscalation: false
            # Reading /proc/<kea pid>/cwd across containers needs ptrace.
            capabilities: { drop: [ALL], add: [SYS_PTRACE, DAC_READ_SEARCH] }
          resources: { requests: { cpu: 20m, memory: 64Mi }, limits: { memory: 256Mi } }
          volumeMounts:
            - { name: config, mountPath: /etc/kea, readOnly: true }
            - { name: logs, mountPath: /var/log/kea, readOnly: true }
            - { name: leases, mountPath: /var/lib/stork-agent, subPath: stork-agent }
{% endif %}
      volumes:
        - name: config
          configMap: { name: {{ fullname }}-config }
        - { name: run, emptyDir: {} }
        - { name: logs, emptyDir: {} }
{% if kea_k8s_lease_storage == 'emptydir' %}
        - { name: leases, emptyDir: {} }
{% else %}
  volumeClaimTemplates:
    - metadata:
        name: leases
        labels: {{ peer_labels | to_json }}
      spec:
        accessModes: [ReadWriteOnce]
{% if kea_k8s_storage_class | length > 0 %}
        storageClassName: {{ kea_k8s_storage_class }}
{% endif %}
        resources: { requests: { storage: {{ kea_k8s_lease_storage_size }} } }
{% endif %}
