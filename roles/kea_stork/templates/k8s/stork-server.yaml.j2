{% if (kea_k8s_stork_server_enabled | bool) %}
apiVersion: v1
kind: Secret
metadata:
  name: stork-server-env
  namespace: {{ kea_k8s_namespace }}
  labels: {{ _kea_k8s_labels | combine({'app.kubernetes.io/name': 'stork-server'}) | to_json }}
type: Opaque
stringData:
  STORK_DATABASE_HOST: {{ stork_db_host | to_json }}
  STORK_DATABASE_PORT: {{ stork_db_port | string | to_json }}
  STORK_DATABASE_NAME: {{ stork_db_name | to_json }}
  STORK_DATABASE_USER_NAME: {{ stork_db_user | to_json }}
  STORK_DATABASE_PASSWORD: {{ stork_db_password | to_json }}
  STORK_DATABASE_SSLMODE: {{ stork_db_sslmode | to_json }}
  STORK_REST_HOST: "0.0.0.0"
  STORK_REST_PORT: {{ stork_server_rest_port | string | to_json }}
  STORK_REST_STATIC_FILES_DIR: /usr/share/stork/www
  STORK_SERVER_ENABLE_METRICS: {{ stork_server_enable_metrics | bool | lower | to_json }}
---
apiVersion: v1
kind: Service
metadata:
  name: stork-server
  namespace: {{ kea_k8s_namespace }}
  labels: {{ _kea_k8s_labels | combine({'app.kubernetes.io/name': 'stork-server'}) | to_json }}
spec:
  type: {{ kea_k8s_stork_server_service_type }}
  selector: { app.kubernetes.io/name: stork-server }
  ports:
    - { name: http, port: {{ stork_server_rest_port }}, targetPort: {{ stork_server_rest_port }}, protocol: TCP }
---
# Single replica: Stork keeps all state in PostgreSQL, so its availability
# is the database's. Run PostgreSQL HA (RDS Multi-AZ, CloudNativePG, ...).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: stork-server
  namespace: {{ kea_k8s_namespace }}
  labels: {{ _kea_k8s_labels | combine({'app.kubernetes.io/name': 'stork-server'}) | to_json }}
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector:
    matchLabels: { app.kubernetes.io/name: stork-server }
  template:
    metadata:
      labels: {{ _kea_k8s_labels | combine({'app.kubernetes.io/name': 'stork-server'}) | to_json }}
    spec:
      securityContext: { runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, seccompProfile: { type: RuntimeDefault } }
      containers:
        - name: stork-server
          image: {{ stork_server_image }}
          command: [stork-server]
          envFrom: [{ secretRef: { name: stork-server-env } }]
          ports: [{ name: http, containerPort: {{ stork_server_rest_port }} }]
          securityContext: { allowPrivilegeEscalation: false, capabilities: { drop: [ALL] } }
          readinessProbe: { httpGet: { path: /api/version, port: http }, periodSeconds: 10 }
          livenessProbe: { httpGet: { path: /api/version, port: http }, initialDelaySeconds: 30, periodSeconds: 20 }
          resources: { requests: { cpu: 50m, memory: 128Mi }, limits: { memory: 512Mi } }
{% endif %}
