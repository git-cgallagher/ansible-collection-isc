{% if (stork_agent_enabled | bool) %}
---
apiVersion: v1
kind: Secret
metadata:
  name: kea-stork-agent
  namespace: {{ kea_k8s_namespace }}
  labels: {{ _kea_k8s_labels | to_json }}
type: Opaque
stringData:
  STORK_AGENT_SERVER_TOKEN: {{ (stork_server_token or (_stork_fetched_token | default(''))) | to_json }}
{% endif %}
