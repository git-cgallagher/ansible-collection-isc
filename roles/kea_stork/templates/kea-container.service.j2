# Managed by Ansible (kea_stork role)
[Unit]
Description=ISC Kea {{ _daemon }} (container)
Wants=network-online.target
After=network-online.target

[Service]
Restart=on-failure
RestartSec=5
ExecStartPre=-{{ _kea_runtime }} rm -f {{ _daemon }}
# kea-dhcp4 always needs NET_RAW in the bounding set: the ISC binary has
# file caps cap_net_bind_service,cap_net_raw=ep and won't exec without it.
# Host networking: DHCP needs the real interfaces (broadcasts / relay
# unicast to the host's IP). Run Kea on a host dedicated to it.
ExecStart={{ _kea_runtime }} run --rm --name {{ _daemon }} \
  --network host \
  --user 0:{{ kea_image_kea_gid }} \
  --cap-drop ALL --cap-add NET_BIND_SERVICE{% if _daemon == 'kea-dhcp4' %} --cap-add NET_RAW{% endif %} \
  -e TZ=UTC \
  -v /etc/kea:/etc/kea:ro \
  -v /var/lib/kea:/var/lib/kea \
  -v {{ kea_control_unix_socket_dir }}:{{ kea_control_unix_socket_dir }} \
  -v /var/log/kea:/var/log/kea \
  {{ _image }} {{ _daemon }} -c {{ _conf }}
ExecReload={{ _kea_runtime }} kill --signal HUP {{ _daemon }}
ExecStop={{ _kea_runtime }} stop -t 10 {{ _daemon }}

[Install]
WantedBy=multi-user.target
