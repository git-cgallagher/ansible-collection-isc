# Managed by Ansible (kea_stork role)
[Unit]
Description=ISC Stork agent (container)
After=network-online.target {{ _kea_daemons | dict2items | selectattr('value.enabled') | map(attribute='key') | map('extract', _kea_services) | map('regex_replace', '$', '.service') | join(' ') }}
Wants=network-online.target

[Service]
Restart=on-failure
RestartSec=5
ExecStartPre=-{{ _kea_runtime }} rm -f stork-agent
# --pid host: Stork finds Kea by scanning /proc and reading the config path
# from Kea's command line; SYS_PTRACE lets it read /proc/<pid>/cwd.
ExecStart={{ _kea_runtime }} run --rm --name stork-agent \
  --network host --pid host --cap-add SYS_PTRACE \
  --env-file /etc/stork/agent.env \
  -v /etc/kea:/etc/kea:ro \
  -v /var/log/kea:/var/log/kea:ro \
  -v /var/lib/stork-agent:/var/lib/stork-agent \
  {{ stork_agent_image }} stork-agent
ExecStop={{ _kea_runtime }} stop -t 10 stork-agent

[Install]
WantedBy=multi-user.target
