# Managed by Ansible (kea_stork role)
STORK_DATABASE_HOST={{ stork_server_db_host }}
STORK_DATABASE_PORT={{ stork_server_db_port }}
STORK_DATABASE_NAME={{ stork_server_db_name }}
STORK_DATABASE_USER_NAME={{ stork_server_db_user }}
STORK_DATABASE_PASSWORD={{ stork_server_db_password }}
STORK_DATABASE_SSLMODE={{ stork_server_db_sslmode }}
STORK_REST_HOST={{ stork_server_rest_host }}
STORK_REST_PORT={{ stork_server_rest_port }}
STORK_REST_STATIC_FILES_DIR=/usr/share/stork/www
STORK_REST_VERSIONS_URL=https://www.isc.org/versions.json
{% if stork_server_tls %}
STORK_REST_TLS_CERTIFICATE={{ stork_server_tls.cert }}
STORK_REST_TLS_PRIVATE_KEY={{ stork_server_tls.key }}
{% if stork_server_tls.ca is defined %}
STORK_REST_TLS_CA_CERTIFICATE={{ stork_server_tls.ca }}
{% endif %}
{% endif %}
STORK_SERVER_ENABLE_METRICS={{ stork_server_enable_metrics | bool | lower }}
{% for k, v in stork_server_extra_env | dictsort %}
{{ k }}={{ v }}
{% endfor %}
